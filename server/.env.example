# ==============================================================
# Loop Server — Environment Configuration
# ==============================================================

# Port (Render/Railway sets this automatically, default 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# JWT Authentication Secret (Generate a random 32+ character string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Origin for CORS (e.g. https://your-loop.pages.dev or https://your-loop.vercel.app)
# Use * to allow all origins during initial setup
CORS_ORIGIN=*

# --------------------------------------------------------------
# Database Configuration (Free Hosted Database — Supabase / Neon)
# --------------------------------------------------------------
# If left blank, the server will automatically use local SQLite (loop.db).
# For production deployment on Render/Railway, paste your Supabase connection string:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --------------------------------------------------------------
# File Storage (Free Cloud Media Storage — Supabase Storage)
# --------------------------------------------------------------
# If left blank, uploads are stored locally in the server's /uploads folder.
# For production, create a public bucket named "loop-media" in Supabase:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_BUCKET=loop-media
